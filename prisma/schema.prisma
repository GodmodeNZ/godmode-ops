generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum TrackingMode { QUANTITY SERIALIZED }
enum InventoryTransactionType { PURCHASE_RECEIPT BUILD_CONSUMPTION CUSTOMER_RETURN SUPPLIER_RETURN TRANSFER_IN TRANSFER_OUT ADJUSTMENT }
enum ReservationStatus { ACTIVE RELEASED CONSUMED }
enum BomLineType { EXACT_SKU REQUIREMENT }
enum BuildStatus { CREATED RESERVED IN_PROGRESS COMPLETED CANCELLED }
model ComponentFamily { id String @id @default(cuid()) name String @unique category String attributes Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt skus Sku[] }
model Sku { id String @id @default(cuid()) code String @unique name String familyId String family ComponentFamily @relation(fields:[familyId],references:[id]) trackingMode TrackingMode @default(QUANTITY) attributes Json? active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt transactions InventoryTransaction[] reservations InventoryReservation[] inventoryUnits InventoryUnit[] bomLines BomLine[] @relation("ExactSku") approvedBomSkus ApprovedBomSku[] unitComponents UnitComponent[] }
model Location { id String @id @default(cuid()) code String @unique name String createdAt DateTime @default(now()) transactions InventoryTransaction[] reservations InventoryReservation[] units InventoryUnit[] }
model InventoryUnit { id String @id @default(cuid()) skuId String sku Sku @relation(fields:[skuId],references:[id]) serialNumber String @unique locationId String? location Location? @relation(fields:[locationId],references:[id]) unitCost Decimal? @db.Decimal(12,2) receivedAt DateTime @default(now()) consumedAt DateTime? }
model InventoryTransaction { id String @id @default(cuid()) skuId String sku Sku @relation(fields:[skuId],references:[id]) locationId String location Location @relation(fields:[locationId],references:[id]) quantityDelta Int type InventoryTransactionType referenceType String? referenceId String? unitCost Decimal? @db.Decimal(12,2) reason String? createdBy String? createdAt DateTime @default(now()) @@index([skuId,locationId]) @@index([referenceType,referenceId]) }
model InventoryReservation { id String @id @default(cuid()) skuId String sku Sku @relation(fields:[skuId],references:[id]) locationId String location Location @relation(fields:[locationId],references:[id]) buildId String build Build @relation(fields:[buildId],references:[id]) quantity Int status ReservationStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([skuId,locationId,status]) }
model Product { id String @id @default(cuid()) code String @unique name String active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt bomVersions BomVersion[] builds Build[] }
model BomVersion { id String @id @default(cuid()) productId String product Product @relation(fields:[productId],references:[id]) version Int active Boolean @default(true) createdAt DateTime @default(now()) lines BomLine[] builds Build[] @@unique([productId,version]) }
model BomLine { id String @id @default(cuid()) bomVersionId String bomVersion BomVersion @relation(fields:[bomVersionId],references:[id],onDelete:Cascade) lineType BomLineType quantity Int role String exactSkuId String? exactSku Sku? @relation("ExactSku",fields:[exactSkuId],references:[id]) requirement Json? approvedSkus ApprovedBomSku[] }
model ApprovedBomSku { id String @id @default(cuid()) bomLineId String bomLine BomLine @relation(fields:[bomLineId],references:[id],onDelete:Cascade) skuId String sku Sku @relation(fields:[skuId],references:[id]) priority Int @default(100) @@unique([bomLineId,skuId]) }
model Build { id String @id @default(cuid()) buildNumber String @unique productId String product Product @relation(fields:[productId],references:[id]) bomVersionId String bomVersion BomVersion @relation(fields:[bomVersionId],references:[id]) status BuildStatus @default(CREATED) externalOrderId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt lines BuildBomLine[] reservations InventoryReservation[] events BuildEvent[] unit GodmodeUnit? }
model BuildBomLine { id String @id @default(cuid()) buildId String build Build @relation(fields:[buildId],references:[id],onDelete:Cascade) role String quantity Int requestedSkuId String? requirement Json? allocatedSkuId String? }
model BuildEvent { id String @id @default(cuid()) buildId String build Build @relation(fields:[buildId],references:[id],onDelete:Cascade) type String actor String? metadata Json? createdAt DateTime @default(now()) }
model GodmodeUnit { id String @id @default(cuid()) unitNumber String @unique buildId String @unique build Build @relation(fields:[buildId],references:[id]) createdAt DateTime @default(now()) completedAt DateTime? components UnitComponent[] }
model UnitComponent { id String @id @default(cuid()) unitId String unit GodmodeUnit @relation(fields:[unitId],references:[id],onDelete:Cascade) skuId String sku Sku @relation(fields:[skuId],references:[id]) role String quantity Int @default(1) serialNumber String? unitCost Decimal? @db.Decimal(12,2) installedAt DateTime @default(now()) removedAt DateTime? }
