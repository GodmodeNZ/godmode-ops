generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrackingMode {
  QUANTITY
  SERIALIZED
}

enum InventoryTransactionType {
  PURCHASE_RECEIPT
  BUILD_CONSUMPTION
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum BomLineType {
  EXACT_SKU
  REQUIREMENT
}

enum BuildStatus {
  CREATED
  RESERVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SalesOrderStatus {
  RECEIVED
  READY_FOR_PRODUCTION
  BLOCKED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum SalesOrderLineStatus {
  UNRESOLVED
  RESOLVED
  BLOCKED
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model ComponentFamily {
  id         String   @id @default(cuid())
  name       String   @unique
  category   String
  attributes Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  skus       Sku[]
}

model Sku {
  id                 String                       @id @default(cuid())
  code               String                       @unique
  name               String
  familyId           String
  family             ComponentFamily              @relation(fields: [familyId], references: [id])
  trackingMode       TrackingMode                 @default(QUANTITY)
  attributes         Json?
  active             Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  barcodes           SkuBarcode[]
  transactions       InventoryTransaction[]
  reservations       InventoryReservation[]
  inventoryUnits     InventoryUnit[]
  bomLines           BomLine[]                    @relation("ExactSku")
  approvedBomSkus    ApprovedBomSku[]
  unitComponents     UnitComponent[]
  configurationRules ShopifyConfigurationRule[]
  supplierSkus       SupplierSku[]
  purchaseOrderLines PurchaseOrderLine[]
  supplierAliases SupplierAlias[]
  shopifyVariants ShopifyCatalogVariant[]
  invoiceLines SupplierInvoiceLine[]
}

model SkuBarcode {
  id        String   @id @default(cuid())
  skuId     String
  sku       Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  value     String   @unique
  kind      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([skuId])
}

model Supplier {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  email         String?
  phone         String?
  website       String?
  accountNumber String?
  notes         String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  supplierSkus  SupplierSku[]
  purchaseOrders PurchaseOrder[]
  aliases SupplierAlias[]
  invoices SupplierInvoice[]
}

model SupplierSku {
  id             String   @id @default(cuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  skuId          String
  sku            Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  supplierCode   String?
  unitCost       Decimal? @db.Decimal(12, 2)
  currency       String   @default("NZD")
  preferred      Boolean  @default(false)
  leadTimeDays   Int?
  minOrderQty    Int?
  lastQuotedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([supplierId, skuId])
  @@index([skuId, preferred])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  number         String              @unique
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @default("NZD")
  supplierRef    String?
  notes          String?
  orderedAt      DateTime?
  expectedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          PurchaseOrderLine[]
  invoices       SupplierInvoice[]

  @@index([supplierId, status])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  skuId           String
  sku             Sku           @relation(fields: [skuId], references: [id])
  supplierCode    String?
  quantityOrdered Int
  quantityReceived Int          @default(0)
  unitCost        Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([skuId])
}

model Location {
  id           String                 @id @default(cuid())
  code         String                 @unique
  name         String
  createdAt    DateTime               @default(now())
  transactions InventoryTransaction[]
  reservations InventoryReservation[]
  units        InventoryUnit[]
}

model InventoryUnit {
  id             String                 @id @default(cuid())
  skuId          String
  sku            Sku                    @relation(fields: [skuId], references: [id])
  serialNumber   String                 @unique
  locationId     String?
  location       Location?              @relation(fields: [locationId], references: [id])
  unitCost       Decimal?               @db.Decimal(12, 2)
  receivedAt     DateTime               @default(now())
  consumedAt     DateTime?
  reservations   InventoryReservation[]
  unitComponents UnitComponent[]

  @@index([skuId, locationId, consumedAt])
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  skuId         String
  sku           Sku                      @relation(fields: [skuId], references: [id])
  locationId    String
  location      Location                 @relation(fields: [locationId], references: [id])
  quantityDelta Int
  type          InventoryTransactionType
  referenceType String?
  referenceId   String?
  unitCost      Decimal?                 @db.Decimal(12, 2)
  reason        String?
  createdBy     String?
  createdAt     DateTime                 @default(now())

  @@index([skuId, locationId])
  @@index([referenceType, referenceId])
}

model InventoryReservation {
  id              String            @id @default(cuid())
  skuId           String
  sku             Sku               @relation(fields: [skuId], references: [id])
  locationId      String
  location        Location          @relation(fields: [locationId], references: [id])
  buildId         String
  build           Build             @relation(fields: [buildId], references: [id])
  buildLineId     String?
  buildLine       BuildBomLine?     @relation(fields: [buildLineId], references: [id])
  inventoryUnitId String?
  inventoryUnit   InventoryUnit?    @relation(fields: [inventoryUnitId], references: [id])
  quantity        Int
  status          ReservationStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([skuId, locationId, status])
  @@index([inventoryUnitId, status])
  @@index([buildId, status])
}

model Product {
  id              String                  @id @default(cuid())
  code            String                  @unique
  name            String
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  bomVersions     BomVersion[]
  builds          Build[]
  shopifyMappings ShopifyProductMapping[]
}

model BomVersion {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  version   Int
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  lines     BomLine[]
  builds    Build[]

  @@unique([productId, version])
}

model BomLine {
  id           String           @id @default(cuid())
  bomVersionId String
  bomVersion   BomVersion       @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  lineType     BomLineType
  quantity     Int
  role         String
  exactSkuId   String?
  exactSku     Sku?             @relation("ExactSku", fields: [exactSkuId], references: [id])
  requirement  Json?
  approvedSkus ApprovedBomSku[]
}

model ApprovedBomSku {
  id        String  @id @default(cuid())
  bomLineId String
  bomLine   BomLine @relation(fields: [bomLineId], references: [id], onDelete: Cascade)
  skuId     String
  sku       Sku     @relation(fields: [skuId], references: [id])
  priority  Int     @default(100)

  @@unique([bomLineId, skuId])
}

model Build {
  id              String                 @id @default(cuid())
  buildNumber     String                 @unique
  productId       String
  product         Product                @relation(fields: [productId], references: [id])
  bomVersionId    String
  bomVersion      BomVersion             @relation(fields: [bomVersionId], references: [id])
  status          BuildStatus            @default(CREATED)
  externalOrderId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  lines           BuildBomLine[]
  reservations    InventoryReservation[]
  events          BuildEvent[]
  unit            GodmodeUnit?
}

model BuildBomLine {
  id             String                 @id @default(cuid())
  buildId        String
  build          Build                  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  role           String
  quantity       Int
  requestedSkuId String?
  requirement    Json?
  allocatedSkuId String?
  reservations   InventoryReservation[]
}

model BuildEvent {
  id        String   @id @default(cuid())
  buildId   String
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  type      String
  actor     String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model GodmodeUnit {
  id          String          @id @default(cuid())
  unitNumber  String          @unique
  buildId     String          @unique
  build       Build           @relation(fields: [buildId], references: [id])
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  components  UnitComponent[]
  shipment    Shipment?
  repairs     RepairTicket[]
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role String @default("OPERATOR")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
}

model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

model Operation {
  key String @id
  fingerprint String
  result Json
  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(cuid())
  actor String
  action String
  reference String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model Shipment {
  id String @id @default(cuid())
  unitId String @unique
  unit GodmodeUnit @relation(fields: [unitId], references: [id])
  carrier String
  trackingNumber String
  dispatchedBy String
  dispatchedAt DateTime @default(now())
}

model RepairTicket {
  id String @id @default(cuid())
  number String @unique
  unitId String
  unit GodmodeUnit @relation(fields: [unitId], references: [id])
  issue String
  status String @default("OPEN")
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UnitComponent {
  id              String         @id @default(cuid())
  unitId          String
  unit            GodmodeUnit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  skuId           String
  sku             Sku            @relation(fields: [skuId], references: [id])
  inventoryUnitId String?
  inventoryUnit   InventoryUnit? @relation(fields: [inventoryUnitId], references: [id])
  role            String
  quantity        Int            @default(1)
  serialNumber    String?
  unitCost        Decimal?       @db.Decimal(12, 2)
  installedAt     DateTime       @default(now())
  removedAt       DateTime?

  @@index([unitId, role])
  @@index([serialNumber])
}

model SalesOrder {
  id                String           @id @default(cuid())
  source            String
  externalId        String
  orderNumber       String
  shopDomain        String?
  financialStatus   String?
  fulfillmentStatus String?
  currency          String?
  total             Decimal?         @db.Decimal(12, 2)
  customerName      String?
  customerEmail     String?
  status            SalesOrderStatus @default(RECEIVED)
  externalCreatedAt DateTime?
  raw               Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lines             SalesOrderLine[]

  @@unique([source, externalId])
  @@index([source, orderNumber])
  @@index([status, createdAt])
}

model SalesOrderLine {
  id                String               @id @default(cuid())
  salesOrderId      String
  salesOrder        SalesOrder           @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  externalLineId    String
  title             String
  sku               String?
  shopifyProductId  String?
  shopifyVariantId  String?
  quantity          Int
  properties        Json?
  status            SalesOrderLineStatus @default(UNRESOLVED)
  resolutionMessage String?
  mappingId         String?
  resolvedProductId String?
  buildIds          String[]             @default([])
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([salesOrderId, externalLineId])
  @@index([status])
}

model ShopifyProductMapping {
  id                 String                     @id @default(cuid())
  shopDomain         String?
  shopifyProductId   String?
  shopifyVariantId   String?
  sku                String?
  productId          String
  product            Product                    @relation(fields: [productId], references: [id])
  active             Boolean                    @default(true)
  priority           Int                        @default(100)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  configurationRules ShopifyConfigurationRule[]

  @@index([shopDomain, shopifyVariantId, active])
  @@index([shopDomain, shopifyProductId, active])
  @@index([shopDomain, sku, active])
}

model ShopifyConfigurationRule {
  id               String                @id @default(cuid())
  mappingId        String
  mapping          ShopifyProductMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  propertyName     String
  propertyValue    String
  role             String
  replacementSkuId String
  replacementSku   Sku                   @relation(fields: [replacementSkuId], references: [id])
  quantity         Int?
  createdAt        DateTime              @default(now())

  @@index([mappingId, propertyName, propertyValue])
}

model IntegrationEvent {
  id              String                 @id @default(cuid())
  provider        String
  externalEventId String
  topic           String
  shopDomain      String?
  status          IntegrationEventStatus @default(RECEIVED)
  triggeredAt     DateTime?
  processedAt     DateTime?
  error           String?
  payload         Json?
  createdAt       DateTime               @default(now())

  @@unique([provider, externalEventId])
  @@index([provider, topic, createdAt])
}


model IntegrationConnection {
  provider String @id
  encrypted String
  metadata Json
  updatedAt DateTime @updatedAt
}

model ShopifyCatalogVariant {
  id String @id @default(cuid())
  shopDomain String
  variantId String
  productId String
  productTitle String
  variantTitle String
  handle String
  vendor String
  productType String
  status String
  shopifySku String?
  barcode String?
  skuId String?
  sku Sku? @relation(fields: [skuId], references: [id])
  matchMethod String?
  confirmedBy String?
  confirmedAt DateTime?
  present Boolean @default(true)
  syncedAt DateTime @default(now())
  @@unique([shopDomain, variantId])
  @@index([skuId])
}

model SupplierAlias {
  id String @id @default(cuid())
  supplierId String
  supplier Supplier @relation(fields: [supplierId], references: [id])
  kind String
  key String
  value String
  skuId String
  sku Sku @relation(fields: [skuId], references: [id])
  confirmedBy String
  updatedAt DateTime @updatedAt
  @@unique([supplierId, kind, key])
}

model SupplierInvoice {
  id String @id @default(cuid())
  fingerprint String @unique
  source String
  sourceRef String?
  sender String?
  subject String?
  supplierId String?
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  invoiceNumber String?
  invoiceKey String? @unique
  invoiceDate DateTime?
  dueDate DateTime?
  currency String @default("NZD")
  subtotal Decimal? @db.Decimal(12,2)
  tax Decimal? @db.Decimal(12,2)
  freight Decimal? @db.Decimal(12,2)
  total Decimal? @db.Decimal(12,2)
  status String @default("REVIEW")
  extractedText String
  extractionWarnings Json
  purchaseOrderId String?
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  lines SupplierInvoiceLine[]
  files InvoiceFile[]
}

model SupplierInvoiceLine {
  id String @id @default(cuid())
  invoiceId String
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position Int
  description String
  supplierCode String?
  barcode String?
  quantity Int?
  unitCost Decimal? @db.Decimal(12,2)
  lineTotal Decimal? @db.Decimal(12,2)
  skuId String?
  sku Sku? @relation(fields: [skuId], references: [id])
  confirmed Boolean @default(false)
  matchReason String?
  matchSnapshot Json?
  @@unique([invoiceId, position])
}

model InvoiceFile {
  id String @id @default(cuid())
  invoiceId String
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  filename String
  contentType String
  data Bytes
}
